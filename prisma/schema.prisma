generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/master"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// USUARIOS DO SISTEMA
// ==========================================
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String
  name          String
  role          String    @default("admin") // superadmin, admin, collaborator
  emailVerified DateTime?
  image         String?

  // Relacionamentos
  tenant        Tenant?   @relation(fields: [tenantId], references: [id])
  tenantId      String?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// ==========================================
// TENANTS (CLIENTES)
// ==========================================
model Tenant {
  id              String    @id @default(cuid())
  name            String
  slug            String    @unique
  email           String
  phone           String?
  document        String?   // CPF ou CNPJ

  // Banco de dados do tenant
  databaseUrl     String?   // URL do banco isolado
  databaseName    String?

  // Dominio personalizado
  customDomain    String?   @unique
  domainVerified  Boolean   @default(false)

  // Visual
  logoUrl         String?
  faviconUrl      String?
  primaryColor    String?   @default("#6366f1")

  // Status
  status          String    @default("active") // active, suspended, cancelled

  // Relacionamentos
  users           User[]
  subscription    Subscription?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// ==========================================
// PLANOS
// ==========================================
model Plan {
  id              String    @id @default(cuid())
  name            String
  slug            String    @unique
  description     String?

  // Precos
  priceMonthly    Float
  priceQuarterly  Float?
  priceYearly     Float?

  // Limites
  maxWebinars     Int       @default(-1) // -1 = ilimitado
  maxLessons      Int       @default(-1)
  maxLeadsMonth   Int       @default(-1)
  maxStorageGB    Int       @default(-1)
  maxUsers        Int       @default(1)

  // Recursos
  customDomain    Boolean   @default(false)
  whiteLabel      Boolean   @default(false)
  webhooks        Boolean   @default(false)
  pixels          Boolean   @default(false)
  prioritySupport Boolean   @default(false)

  // UI
  isPopular       Boolean   @default(false)
  isActive        Boolean   @default(true)
  sortOrder       Int       @default(0)

  // Relacionamentos
  subscriptions   Subscription[]

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// ==========================================
// ASSINATURAS
// ==========================================
model Subscription {
  id                  String    @id @default(cuid())

  // Relacionamentos
  tenant              Tenant    @relation(fields: [tenantId], references: [id])
  tenantId            String    @unique
  plan                Plan      @relation(fields: [planId], references: [id])
  planId              String

  // Asaas
  asaasCustomerId     String?
  asaasSubscriptionId String?

  // Status
  status              String    @default("active") // active, overdue, cancelled, suspended
  billingCycle        String    @default("monthly") // monthly, quarterly, yearly

  // Datas
  currentPeriodStart  DateTime?
  currentPeriodEnd    DateTime?
  cancelledAt         DateTime?

  // Pagamento
  payments            Payment[]

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

// ==========================================
// PAGAMENTOS
// ==========================================
model Payment {
  id             String       @id @default(cuid())

  subscription   Subscription @relation(fields: [subscriptionId], references: [id])
  subscriptionId String

  // Asaas
  asaasPaymentId String?      @unique

  // Valores
  amount         Float
  netAmount      Float?

  // Status
  status         String       // pending, confirmed, received, overdue, refunded
  billingType    String       // PIX, BOLETO, CREDIT_CARD

  // Datas
  dueDate        DateTime?
  paymentDate    DateTime?

  // Webhook source (se veio de integracao)
  source         String?      // asaas, hotmart, kiwify, ticto, cartpanda
  externalId     String?

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

// ==========================================
// PAGINAS (PAGE BUILDER)
// ==========================================
model Page {
  id              String    @id @default(cuid())
  title           String
  slug            String    @unique

  // Tipo
  type            String    @default("normal") // home, normal, 404, terms, privacy

  // Conteudo
  htmlContent     String?   @db.Text
  cssContent      String?   @db.Text
  jsContent       String?   @db.Text

  // SEO
  metaTitle       String?
  metaDescription String?

  // Status
  status          String    @default("draft") // draft, published

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// ==========================================
// CONFIGURACOES DO SISTEMA
// ==========================================
model SystemSettings {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==========================================
// WEBHOOKS DE INTEGRACAO
// ==========================================
model PaymentWebhook {
  id        String   @id @default(cuid())
  source    String   // hotmart, kiwify, ticto, cartpanda
  event     String
  payload   Json
  processed Boolean  @default(false)
  error     String?
  createdAt DateTime @default(now())
}
