# ===========================================
# WEBINAR HUB SAAS - VARIAVEIS DE AMBIENTE
# ===========================================

# App
NEXT_PUBLIC_APP_URL=https://webnar.agemidea.com.br
NEXTAUTH_URL=https://webnar.agemidea.com.br
NEXTAUTH_SECRET=gerar_com_openssl_rand_base64_32
AUTH_SECRET=gerar_com_openssl_rand_base64_32

# Database (Supabase/Neon/PlanetScale)
DATABASE_URL=postgresql://user:pass@host:5432/webinar_hub_master

# Tenant schema helper (usado para comandos de tenant)
TENANT_DATABASE_URL=postgresql://user:pass@host:5432/webinar_hub_master

# Asaas
ASAAS_API_KEY=sua_api_key
ASAAS_ENV=production
ASAAS_WEBHOOK_TOKEN=token_seguro_para_validar_webhooks

# Webhooks Externos
WEBHOOK_SECRET_HOTMART=
WEBHOOK_SECRET_KIWIFY=
WEBHOOK_SECRET_TICTO=
WEBHOOK_SECRET_CARTPANDA=

# Email (Resend)
RESEND_API_KEY=

# Vercel (Deploy)
VERCEL_URL=
